# These are set in Cloudflare Pages → Settings → Variables and Secrets (type: Secret), not in this file.
# They are only used by the server functions in /functions and never reach the browser.

# Paystack SECRET key (sk_test_... while testing, sk_live_... for real payments)
PAYSTACK_SECRET_KEY=

# Optional: order emails via https://resend.com (owner notification + branded customer receipt)
RESEND_API_KEY=
ORDER_EMAIL_FROM="Lynux Espadrilles <orders@lynuxespadrilles.co.za>"
ORDER_NOTIFY_EMAIL=
